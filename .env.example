# ============================================================
# Social Zip — Manus Audit Webhook — Environment Variables
# ============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ============================================================

# HTTP port (most platforms set this automatically)
PORT=3000

# Secret that Manus must send in the x-webhook-secret header
# (or as Authorization: Bearer <secret>)
# Change this from the default before deploying.
WEBHOOK_SECRET=socialzip-manus-2024

# Go High Level Private Integration Token
# Generate one at: https://app.gohighlevel.com > Settings > Private Integrations
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Set to any value to bypass webhook secret validation (dev only — NEVER in production)
# SKIP_AUTH=true
